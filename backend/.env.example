# PostgreSQL connection string (Vercel Postgres / Supabase / PlanetScale, etc.)
DATABASE_URL="postgresql://user:password@host:5432/minmax?sslmode=require"

# JWT secret — use a long random string in production
JWT_SECRET="change-this-to-a-long-random-secret"

# Optional: server port (defaults to 3000 if not set)
PORT=3000
